.venv/
.venv-build/
/build/windows/
/dist/
__pycache__/
*.py[cod]
/dev_orchestrator/runs/
/.agent-sessions/

# Local tool state / caches
/.opencode/tools/
/.opencode/cache/
/.opencode/ostacky-state.json
/.opencode/ostacky-state.json.backup*
/.opencode/ostacky-state.json.lock.*
