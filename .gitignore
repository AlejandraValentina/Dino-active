# Heavy simulation artifacts stay outside the active Git repository.
# Keep compact manifests/summaries/results, but never raw cycles/checkpoints/primaries.
/results/**/*.json.gz
/results/**/*cycle*.json
/results/**/*checkpoint*.json
/results/**/*primary*.json
/results/**/*trace*.jsonl
/results/**/*.npz
/results/**/*.prof
/results/**/*.log
/results/distribucion-windows/
/results/simulacion-2t/
