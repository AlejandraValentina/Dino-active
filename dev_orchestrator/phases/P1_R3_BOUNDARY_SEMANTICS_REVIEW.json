      "timeout": 650,
      "result_file": "artifacts/result.json"
    }
  ],
  "required_tests": [
    "boundary_tests",
    "fix_tests"
  ],
  "required_checks": [
    "boundary_tests",
    "fix_tests",
    "boundary_study",
    "T05",
    "mesh_sign",
    "all_ledgers",
    "NR01_recorded",
    "counter_identity",
    "baseline_intact",
    "contract_frozen",
    "dependencies_accepted"
