{
  "phase": "P3C",
  "objective": "Variable volume and acoustic refinement after independent P3B PASS",
  "enabled": true,
  "depends_on": [
    "P2"
  ],
  "allowed_paths": [
    "dev_orchestrator/runs/"
  ],
  "forbidden_paths": [
    "motorsim/",
    "packaging/"
  ],
  "allowed_changes": [
    "Evidence only; source committed before run."
  ],
  "forbidden_changes": [
    "Toda modificaci\u00f3n de producto en esta versi\u00f3n."
  ],
  "commands": [
    {
      "id": "acoustic_cases",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "dev_orchestrator.p3_acoustic",
        "--run-dir",
        "{run_dir}"
      ],
      "timeout": 3400,
      "result_file": "artifacts/result.json"
    }
  ],
  "required_tests": [],
  "required_checks": [
    "acoustic_cases",
    "P3C"
  ],
  "required_evidence": [
    "artifacts/summary.json",
    "artifacts/inventory.json",
    "artifacts/result.json"
  ],
  "gate": "default",
  "max_repair_attempts": 0,
  "review": "required",
  "human_gate": true,
  "scientific_changes_authorized": false,
  "timeout": 3500
}
