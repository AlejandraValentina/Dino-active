{
  "phase": "P1",
  "objective": "1D mathematical contract: ecuaciones, método, interfaces y T01–T12; sin solver ni P2.",
  "enabled": true,
  "depends_on": [
    "P0"
  ],
  "allowed_paths": [
    "dev_orchestrator/runs/"
  ],
  "forbidden_paths": [
    "motorsim/",
    "packaging/"
  ],
  "allowed_changes": [
    "Evidencia contractual P1; ninguna modificación de producción."
  ],
  "forbidden_changes": [
    "Toda modificación de producto en esta versión."
  ],
  "commands": [
    {
      "id": "p1_tests",
      "kind": "test",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_p1_contract.py",
        "-v"
      ],
      "timeout": 60
    },
    {
      "id": "p1_contract",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "dev_orchestrator.p1_contract",
        "--run-dir",
        "{run_dir}"
      ],
      "timeout": 60,
      "result_file": "artifacts/result.json"
    }
  ],
  "required_tests": [
    "p1_tests"
  ],
  "required_checks": [
    "p1_tests",
    "p1_contract",
    "contract_complete",
    "p0_accepted",
    "scope_preserved"
  ],
  "required_evidence": [
    "artifacts/result.json",
    "artifacts/contract-inventory.json",
    "artifacts/git-before.json"
  ],
  "gate": "default",
  "max_repair_attempts": 0,
  "review": "required",
  "human_gate": true,
  "scientific_changes_authorized": false,
  "timeout": 180
}
