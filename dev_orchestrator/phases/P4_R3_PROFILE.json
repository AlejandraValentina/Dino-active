{
  "phase": "P4_R3_PROFILE",
  "objective": "Standard-library profile of three frozen hybrid windows",
  "enabled": true,
  "depends_on": [
    "P2"
  ],
  "allowed_paths": [
    "dev_orchestrator/runs/"
  ],
  "forbidden_paths": [
    "motorsim/",
    "packaging/"
  ],
  "allowed_changes": [
    "Evidence only; source committed before run."
  ],
  "forbidden_changes": [
    "Toda modificación de producto en esta versión."
  ],
  "commands": [
    {
      "id": "profile_command",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "dev_orchestrator.p4_r3_profile",
        "--run-dir",
        "{run_dir}"
      ],
      "timeout": 300,
      "result_file": "artifacts/result.json"
    }
  ],
  "required_tests": [],
  "required_checks": [
    "profile_command",
    "profile_complete"
  ],
  "required_evidence": [
    "artifacts/profile-summary.json",
    "artifacts/result.json"
  ],
  "gate": "default",
  "max_repair_attempts": 0,
  "review": "required",
  "human_gate": true,
  "scientific_changes_authorized": false,
  "timeout": 400
}
