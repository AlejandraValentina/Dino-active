{
  "phase": "P4C_PREFLIGHT",
  "objective": "One hybrid cycle cost guard before bounded periodic campaign",
  "enabled": true,
  "depends_on": [
    "P2"
  ],
  "allowed_paths": [
    "dev_orchestrator/runs/"
  ],
  "forbidden_paths": [
    "motorsim/",
    "packaging/"
  ],
  "allowed_changes": [
    "Evidence only; source committed before run."
  ],
  "forbidden_changes": [
    "Toda modificaci\u00f3n de producto en esta versi\u00f3n."
  ],
  "commands": [
    {
      "id": "hybrid_tests",
      "kind": "test",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_hybrid_exhaust.py",
        "-v"
      ],
      "timeout": 60
    },
    {
      "id": "hybrid_command",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "dev_orchestrator.p4_hybrid",
        "--run-dir",
        "{run_dir}"
      ],
      "timeout": 1400,
      "result_file": "artifacts/result.json"
    }
  ],
  "required_tests": [
    "hybrid_tests"
  ],
  "required_checks": [
    "hybrid_tests",
    "hybrid_command",
    "hybrid_evidence",
    "frozen_implementation"
  ],
  "required_evidence": [
    "artifacts/summary.json",
    "artifacts/inputs.json",
    "artifacts/inventory.json",
    "artifacts/result.json"
  ],
  "gate": "default",
  "max_repair_attempts": 0,
  "review": "required",
  "human_gate": true,
  "scientific_changes_authorized": false,
  "timeout": 1500
}
