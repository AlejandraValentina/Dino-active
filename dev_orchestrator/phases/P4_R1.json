{
  "phase": "P4_R1",
  "objective": "Frozen blowdown observables and focal convergence diagnosis",
  "enabled": true,
  "depends_on": [
    "P2"
  ],
  "allowed_paths": [
    "dev_orchestrator/runs/"
  ],
  "forbidden_paths": [
    "motorsim/",
    "packaging/"
  ],
  "allowed_changes": [
    "Evidence only; source committed before run."
  ],
  "forbidden_changes": [
    "Toda modificaci\u00f3n de producto en esta versi\u00f3n."
  ],
  "commands": [
    {
      "id": "observable_tests",
      "kind": "test",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_p4_r1.py",
        "-v"
      ],
      "timeout": 120
    },
    {
      "id": "diagnostic_command",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "dev_orchestrator.p4_r1",
        "--run-dir",
        "{run_dir}"
      ],
      "timeout": 3500,
      "result_file": "artifacts/result.json"
    }
  ],
  "required_tests": [
    "observable_tests"
  ],
  "required_checks": [
    "observable_tests",
    "diagnostic_command",
    "diagnostic_evidence",
    "frozen_implementation"
  ],
  "required_evidence": [
    "artifacts/summary.json",
    "artifacts/inventory.json",
    "artifacts/historical-audit.json",
    "artifacts/result.json"
  ],
  "gate": "default",
  "max_repair_attempts": 0,
  "review": "required",
  "human_gate": true,
  "scientific_changes_authorized": false,
  "timeout": 3700
}
