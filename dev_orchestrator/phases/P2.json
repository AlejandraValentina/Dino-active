{
  "phase": "P2",
  "objective": "P2A first-order isolated quasi-1D core, T01–T12, P2B only after reviewed P2A PASS; no P3.",
  "enabled": true,
  "depends_on": [
    "P0",
    "P1"
  ],
  "allowed_paths": [
    "dev_orchestrator/runs/"
  ],
  "forbidden_paths": [
    "docs/baselines/",
    "packaging/"
  ],
  "allowed_changes": [
    "Run evidence only; implementation committed before verification."
  ],
  "forbidden_changes": [
    "Toda modificación de producto en esta versión."
  ],
  "commands": [
    {
      "id": "p2_unit",
      "kind": "test",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_gas1d.py",
        "-v"
      ],
      "timeout": 60
    },
    {
      "id": "p2a_campaign",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "dev_orchestrator.p2_campaign",
        "--run-dir",
        "{run_dir}"
      ],
      "timeout": 3600,
      "result_file": "artifacts/result.json"
    }
  ],
  "required_tests": [
    "p2_unit"
  ],
  "required_checks": [
    "p2_unit",
    "p2a_campaign",
    "P2A",
    "baseline_intact",
    "contract_frozen",
    "dependencies_accepted"
  ],
  "required_evidence": [
    "artifacts/result.json",
    "artifacts/p2a-summary.json",
    "artifacts/inventory.json",
    "artifacts/git-before.json"
  ],
  "gate": "default",
  "max_repair_attempts": 3,
  "review": "required",
  "human_gate": true,
  "scientific_changes_authorized": false,
  "timeout": 3700
}
