{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "command-result",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "benchmark",
              "numerical",
              "infrastructure"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "passed",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "scientific_change_required": {
      "type": "boolean"
    }
  },
  "required": [
    "checks",
    "metrics",
    "scientific_change_required"
  ],
  "additionalProperties": false
}
